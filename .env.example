# Copy to .env and replace every CHANGE_ME value. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WORKER_HEALTH_PORT=3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Empty means forwarding headers are untrusted. Set only known ingress IPs/CIDRs.
TRUST_PROXY_CIDRS=

# Host-based development / migration owner connection. In production, migrations
# and runtime processes MUST use separate credentials.
POSTGRES_DB=amrutam
POSTGRES_USER=amrutam_owner
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
API_DB_PASSWORD=CHANGE_ME_API_PASSWORD
WORKER_DB_PASSWORD=CHANGE_ME_WORKER_PASSWORD
DATABASE_URL=postgresql://amrutam_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/amrutam
DATABASE_SSL_MODE=disable
# DATABASE_CA_CERT=PEM certificate supplied by the deployment secret store
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Docker API/worker use their own restricted database users, not the owner.
API_DATABASE_URL=postgresql://amrutam_api:CHANGE_ME_API_PASSWORD@postgres:5432/amrutam
WORKER_DATABASE_URL=postgresql://amrutam_worker:CHANGE_ME_WORKER_PASSWORD@postgres:5432/amrutam
MIGRATION_DATABASE_URL=postgresql://amrutam_owner:CHANGE_ME_OWNER_PASSWORD@postgres:5432/amrutam
REDIS_URL=redis://localhost:6379/0
COMPOSE_REDIS_URL=redis://redis:6379/0

# Dangerous local rollback is opt-in. Forward migrations are the deployment default.
ALLOW_DESTRUCTIVE_MIGRATIONS=false
# Integration tests require a separate database with a name ending in _test.
# TEST_DATABASE_URL=postgresql://amrutam_owner:...@localhost:5432/amrutam_test
# TEST_REDIS_URL=redis://localhost:6379/15

# Generate fresh LOCAL values with npm run security:generate-env. Local dev and
# operator scripts load ignored work/security.env after .env; Docker accepts both
# via --env-file .env --env-file work/security.env. Never use test keys.
# Production keys must come from your deployment's secret store.
AUTH_JWT_KEY_ID=CHANGE_ME_KEY_ID
AUTH_JWT_PRIVATE_KEY_BASE64=CHANGE_ME_BASE64_PKCS8_ED25519_PEM
AUTH_JWT_PUBLIC_KEYS='{"CHANGE_ME_KEY_ID":"CHANGE_ME_BASE64_SPKI_ED25519_PEM"}'
AUTH_ENCRYPTION_KEY_ID=CHANGE_ME_KEY_ID
AUTH_ENCRYPTION_KEYS='{"CHANGE_ME_KEY_ID":"CHANGE_ME_BASE64_32_BYTE_KEY"}'
AUTH_TOKEN_PEPPER_BASE64=CHANGE_ME_INDEPENDENT_BASE64_32_BYTE_KEY
AUTH_JWT_ISSUER=https://amrutam.local
AUTH_JWT_AUDIENCE=amrutam-api
AUTH_ACCESS_TTL_SECONDS=300
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SETUP_TTL_SECONDS=3600
AUTH_RETRY_TTL_SECONDS=30
AUTH_LOGIN_LIMIT=10
AUTH_IP_LIMIT=60

# Durable outbox polling and lease fencing. Worker needs no clinical/auth keys.
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000

# Separate operational role; only approved SQL maintenance functions.
MAINTENANCE_DB_PASSWORD=CHANGE_ME_UNIQUE_MAINTENANCE_PASSWORD
MAINTENANCE_DATABASE_URL=postgresql://amrutam_maintenance:CHANGE_ME_UNIQUE_MAINTENANCE_PASSWORD@postgres:5432/amrutam
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_GRAFANA_PASSWORD
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=0.1
