{
  "name": "amrutam-telemedicine-backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Amrutam backend assignment — secure workflows, infrastructure and observability",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=work/security.env --watch --import tsx src/entrypoints/api.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/entrypoints/worker.ts",
    "start": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/integration",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/entrypoints/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env --import tsx src/entrypoints/migrate.ts down",
    "db:status": "node --env-file-if-exists=.env --import tsx src/entrypoints/migrate.ts status",
    "db:migrate:production": "node dist/entrypoints/migrate.js up",
    "openapi:generate": "node --import tsx src/entrypoints/openapi.ts",
    "openapi:check": "node --import tsx src/entrypoints/openapi.ts --check",
    "security:generate-env": "node --import tsx src/entrypoints/security-env.ts",
    "identity:operator": "node --env-file-if-exists=.env --env-file-if-exists=work/security.env --import tsx src/entrypoints/identity-operator.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx src/entrypoints/maintenance.ts",
    "repository:check": "node scripts/repository-check.mjs",
    "performance": "node --env-file-if-exists=.env --import tsx scripts/performance.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.9.0"
  }
}
