{
  "uid": "amrutam-ops",
  "title": "Amrutam operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Read p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket{method=\"GET\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Write p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket{method=~\"POST|PUT|PATCH|DELETE\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(status)(rate(http_request_duration_seconds_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Booking conflicts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(booking_conflicts_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Database pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "db_pool_connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Worker backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "worker_backlog",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Oldest pending seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "worker_oldest_pending_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Authentication abuse",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(reason)(rate(auth_failures_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Job outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(worker_jobs_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
